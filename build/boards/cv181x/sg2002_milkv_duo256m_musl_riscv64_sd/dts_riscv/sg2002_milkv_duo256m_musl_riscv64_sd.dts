/dts-v1/;
#include "cv181x_base_riscv.dtsi"
#include "cv181x_asic_qfn.dtsi"
#include "cv181x_asic_sd.dtsi"
#include "cv181x_default_memmap.dtsi"

/ {
	model = "Milk-V Duo256M";

	gpio_keys {
		compatible = "gpio-keys";

		power_button {
			label = "power";
			linux,code = <116>;
			
			gpios = <&porta 23 GPIO_ACTIVE_LOW>;
			
			debounce-interval = <10>;
			wakeup-source;
		};
	};
};

&mipi_rx {
	snsr-reset = <&portc 17 GPIO_ACTIVE_LOW>, <&portc 17 GPIO_ACTIVE_LOW>, <&portc 17 GPIO_ACTIVE_LOW>;
};

&i2c0 {
	status = "disabled";
};

&i2c4 {
	status = "disabled";
};

&spi2 {
    status = "okay";
    /delete-node/ spidev@0;

    st7789v@0 {
    	compatible = "sitronix,st7789v";
    	reg = <0>;
		status = "okay";
    	spi-max-frequency = <48000000>;
		spi-cpol;
		spi-cpha;
		rgb;
    	buswidth = <8>;
    	rotate = <0>;
    	fps = <60>;

    	dc = <&porta 25 GPIO_ACTIVE_HIGH>;
    	reset = <&porta 26 GPIO_ACTIVE_LOW>;
    	backlight = <&porta 27 GPIO_ACTIVE_HIGH>;

		debug = <0x0>;
	};
};

&dac {
	mute-gpio-r = <&porte 1 GPIO_ACTIVE_LOW>;
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&ethernet0 {
	status = "disabled";
};